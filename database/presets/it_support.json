    "workflows": {
        "bookings": {
            "stages": [
                {"code": "tiket_masuk", "label": "Tiket Masuk"},
                {"code": "dijadwalkan", "label": "Dijadwalkan"},
                {"code": "penanganan", "label": "Penanganan"},
                {"code": "verifikasi", "label": "Verifikasi Klien"},
                {"code": "selesai", "label": "Selesai"},
                {"code": "dibatalkan", "label": "Dibatalkan"}
            ],
            "transitions": [
                {"from": "tiket_masuk", "to": "dijadwalkan", "roles": ["owner", "staff"]},
                {"from": "dijadwalkan", "to": "penanganan", "roles": ["owner", "staff"], "effects": ["stock.reserve"]},
                {"from": "penanganan", "to": "verifikasi", "roles": ["owner", "staff"], "effects": ["stock.deduct"]},
                {"from": "verifikasi", "to": "selesai", "roles": ["owner"], "effects": ["invoice.create_final"]},
                {"from": "verifikasi", "to": "penanganan", "roles": ["owner", "staff"], "requires_note": true},
                {"from": "*", "to": "dibatalkan", "roles": ["owner"]}
            ],
            "terminal": ["selesai", "dibatalkan"]
        }
    },
    "dashboard": {
        "industry_zone": [
            {"widget": "upcoming_schedule"},
            {"widget": "deals_pipeline"},
            {"widget": "kpi_cashflow"},
            {"widget": "pending_approvals"}
        ]
    },
    "menus": {
        "order": ["dashboard", "bookings", "projects", "quotations", "contacts", "inventory", "employees", "accounting", "settings"]
    },
    "description": "Tiket kunjungan berkala per klien, penjadwalan teknisi lapangan, pemakaian sparepart, dan jam kerja yang ditagihkan."
