{
  "$schema": "agentic-bos/entity-schema/v1",
  "entity": "cash_entries",
  "version": 1,
  "company_scope": "folder",
  "required": [
    "id",
    "entry_date",
    "direction",
    "amount"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "unsigned": true
    },
    "entry_date": {
      "type": "string",
      "format": "date"
    },
    "direction": {
      "type": "string",
      "length": 8,
      "enum": [
        "in",
        "out"
      ]
    },
    "amount": {
      "type": "number",
      "precision": 18,
      "scale": 2,
      "minimum": 0
    },
    "category": {
      "type": "string",
      "nullable": true,
      "length": 64
    },
    "description": {
      "type": "string",
      "nullable": true,
      "length": 255
    },
    "contact_id": {
      "type": "integer",
      "nullable": true,
      "unsigned": true
    },
    "project_id": {
      "type": "integer",
      "nullable": true,
      "unsigned": true
    },
    "source_type": {
      "type": "string",
      "nullable": true,
      "length": 191
    },
    "source_id": {
      "type": "integer",
      "nullable": true,
      "unsigned": true
    },
    "journal_id": {
      "type": "integer",
      "nullable": true,
      "unsigned": true
    },
    "created_by_user_id": {
      "type": "integer",
      "nullable": true,
      "unsigned": true
    },
    "created_at": {
      "type": "string",
      "nullable": true,
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "nullable": true,
      "format": "date-time"
    }
  },
  "attributes": {
    "notes": {
      "type": "string",
      "nullable": true,
      "length": 191
    },
    "external_reference": {
      "type": "string",
      "nullable": true,
      "length": 128
    },
    "custom": {
      "type": "object",
      "nullable": true
    }
  },
  "indexes": [
    {
      "fields": [
        "entry_date"
      ],
      "company_scoped": true
    }
  ],
  "unique": [],
  "references": {
    "contact_id": {
      "entity": "contacts",
      "on_delete": "set_null"
    },
    "project_id": {
      "entity": "projects",
      "on_delete": "set_null"
    },
    "journal_id": {
      "entity": "accounting_journals",
      "on_delete": "set_null"
    },
    "created_by_user_id": {
      "entity": "users",
      "on_delete": "set_null"
    }
  }
}
