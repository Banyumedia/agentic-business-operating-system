{
    "$schema": "agentic-bos/entity-schema/v1",
    "entity": "production_orders",
    "version": 1,
    "company_scope": "folder",
    "properties": {
        "id": { "type": "integer", "unsigned": true },
        "external_ref": { "type": "string", "length": 128, "nullable": true },
        "item_id": { "type": "integer", "unsigned": true },
        "target_qty": { "type": "number", "precision": 10, "scale": 3, "minimum": 0 },
        "stage": { "type": "string", "length": 32, "default": "draft" },
        "started_at": { "type": "string", "format": "date-time", "nullable": true },
        "completed_at": { "type": "string", "format": "date-time", "nullable": true },
        "created_at": { "type": "string", "format": "date-time", "nullable": true },
        "updated_at": { "type": "string", "format": "date-time", "nullable": true }
    },
    "required": [
        "id",
        "item_id",
        "target_qty"
    ],
    "attributes": {},
    "indexes": [
        {
            "fields": ["stage"],
            "company_scoped": true
        }
    ],
    "references": {
        "item_id": { "entity": "items", "on_delete": "restrict" }
    },
    "unique": [
        { "fields": ["external_ref"], "company_scoped": true }
    ]
}
