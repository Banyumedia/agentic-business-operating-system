{
  "$schema": "agentic-bos/entity-schema/v1",
  "entity": "order_lines",
  "version": 1,
  "company_scope": "folder",
  "required": [
    "id",
    "order_id",
    "description",
    "qty",
    "unit_price",
    "line_total"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "unsigned": true
    },
    "order_id": {
      "type": "integer",
      "unsigned": true
    },
    "item_id": {
      "type": "integer",
      "nullable": true,
      "unsigned": true
    },
    "description": {
      "type": "string",
      "length": 191
    },
    "qty": {
      "type": "number",
      "precision": 14,
      "scale": 3,
      "minimum": 0
    },
    "unit_price": {
      "type": "number",
      "precision": 18,
      "scale": 2,
      "minimum": 0
    },
    "discount_amount": {
      "type": "number",
      "default": 0,
      "precision": 18,
      "scale": 2,
      "minimum": 0
    },
    "line_total": {
      "type": "number",
      "precision": 18,
      "scale": 2,
      "minimum": 0
    },
    "fired_at": {
      "type": "string",
      "nullable": true,
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "nullable": true,
      "format": "date-time"
    }
  },
  "attributes": {
    "notes": {
      "type": "string",
      "nullable": true,
      "length": 191
    },
    "external_reference": {
      "type": "string",
      "nullable": true,
      "length": 128
    },
    "custom": {
      "type": "object",
      "nullable": true
    }
  },
  "indexes": [
    {
      "fields": [
        "order_id"
      ],
      "company_scoped": true
    }
  ],
  "unique": [],
  "references": {
    "order_id": {
      "entity": "orders",
      "on_delete": "cascade"
    },
    "item_id": {
      "entity": "items",
      "on_delete": "set_null"
    }
  }
}
