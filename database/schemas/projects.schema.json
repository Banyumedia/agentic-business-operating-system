{
  "$schema": "agentic-bos/entity-schema/v1",
  "entity": "projects",
  "version": 1,
  "company_scope": "folder",
  "required": [
    "id",
    "name"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "unsigned": true
    },
    "contact_id": {
      "type": "integer",
      "nullable": true,
      "unsigned": true
    },
    "deal_id": {
      "type": "integer",
      "nullable": true,
      "unsigned": true
    },
    "type": {
      "type": "string",
      "default": "project",
      "length": 32
    },
    "name": {
      "type": "string",
      "length": 191
    },
    "stage": {
      "type": "string",
      "default": "planned",
      "length": 32
    },
    "starts_at": {
      "type": "string",
      "nullable": true,
      "format": "date-time"
    },
    "ends_at": {
      "type": "string",
      "nullable": true,
      "format": "date-time"
    },
    "venue": {
      "type": "string",
      "nullable": true,
      "length": 191
    },
    "budget": {
      "type": "number",
      "nullable": true,
      "precision": 18,
      "scale": 2,
      "minimum": 0
    },
    "progress_pct": {
      "type": "number",
      "default": 0,
      "precision": 5,
      "scale": 2,
      "minimum": 0,
      "maximum": 100
    },
    "owner_user_id": {
      "type": "integer",
      "nullable": true,
      "unsigned": true
    },
    "attributes": {
      "type": "object",
      "nullable": true
    },
    "created_at": {
      "type": "string",
      "nullable": true,
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "nullable": true,
      "format": "date-time"
    }
  },
  "attributes": {
    "notes": {
      "type": "string",
      "nullable": true,
      "length": 191
    },
    "external_reference": {
      "type": "string",
      "nullable": true,
      "length": 128
    },
    "custom": {
      "type": "object",
      "nullable": true
    }
  },
  "indexes": [
    {
      "fields": [
        "stage"
      ],
      "company_scoped": true
    }
  ],
  "unique": [],
  "references": {
    "contact_id": {
      "entity": "contacts",
      "on_delete": "set_null"
    },
    "deal_id": {
      "entity": "deals",
      "on_delete": "set_null"
    },
    "owner_user_id": {
      "entity": "users",
      "on_delete": "set_null"
    }
  }
}
