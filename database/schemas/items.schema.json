{
  "$schema": "agentic-bos/entity-schema/v1",
  "entity": "items",
  "version": 1,
  "company_scope": "folder",
  "required": [
    "id",
    "name"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "unsigned": true
    },
    "sku": {
      "type": "string",
      "nullable": true,
      "length": 64
    },
    "name": {
      "type": "string",
      "length": 191
    },
    "type": {
      "type": "string",
      "default": "goods",
      "length": 32
    },
    "unit": {
      "type": "string",
      "default": "pcs",
      "length": 16
    },
    "price": {
      "type": "number",
      "nullable": true,
      "precision": 18,
      "scale": 2,
      "minimum": 0
    },
    "cost": {
      "type": "number",
      "nullable": true,
      "precision": 18,
      "scale": 2,
      "minimum": 0
    },
    "min_stock": {
      "type": "number",
      "default": 0,
      "precision": 14,
      "scale": 3,
      "minimum": 0
    },
    "track_batches": {
      "type": "boolean",
      "default": false
    },
    "attributes": {
      "type": "object",
      "nullable": true
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "created_at": {
      "type": "string",
      "nullable": true,
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "nullable": true,
      "format": "date-time"
    }
  },
  "attributes": {
    "notes": {
      "type": "string",
      "nullable": true,
      "length": 191
    },
    "external_reference": {
      "type": "string",
      "nullable": true,
      "length": 128
    },
    "custom": {
      "type": "object",
      "nullable": true
    }
  },
  "indexes": [],
  "unique": [
    {
      "fields": [
        "sku"
      ],
      "company_scoped": true
    }
  ],
  "references": {}
}
