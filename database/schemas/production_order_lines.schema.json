{
    "$schema": "agentic-bos/entity-schema/v1",
    "entity": "production_order_lines",
    "version": 1,
    "company_scope": "folder",
    "properties": {
        "id": { "type": "integer", "unsigned": true },
        "production_order_id": { "type": "integer", "unsigned": true },
        "component_item_id": { "type": "integer", "unsigned": true },
        "planned_qty": { "type": "number", "precision": 10, "scale": 3, "minimum": 0 },
        "actual_qty": { "type": "number", "precision": 10, "scale": 3, "minimum": 0, "nullable": true },
        "cost_per_unit": { "type": "number", "precision": 15, "scale": 2, "nullable": true }
    },
    "required": [
        "id",
        "production_order_id",
        "component_item_id",
        "planned_qty"
    ],
    "references": {
        "production_order_id": { "entity": "production_orders", "on_delete": "cascade" },
        "component_item_id": { "entity": "items", "on_delete": "restrict" }
    }
}
