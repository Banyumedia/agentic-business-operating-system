{
  "$schema": "agentic-bos/entity-schema/v1",
  "entity": "accounting_journals",
  "version": 1,
  "company_scope": "folder",
  "required": [
    "id",
    "journal_number",
    "transaction_date"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "unsigned": true
    },
    "journal_number": {
      "type": "string",
      "length": 64
    },
    "transaction_date": {
      "type": "string",
      "format": "date"
    },
    "reference": {
      "type": "string",
      "nullable": true,
      "length": 191
    },
    "description": {
      "type": "string",
      "nullable": true,
      "length": 1000
    },
    "created_at": {
      "type": "string",
      "nullable": true,
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "nullable": true,
      "format": "date-time"
    }
  },
  "attributes": {
    "notes": {
      "type": "string",
      "nullable": true,
      "length": 191
    },
    "external_reference": {
      "type": "string",
      "nullable": true,
      "length": 128
    },
    "custom": {
      "type": "object",
      "nullable": true
    }
  },
  "indexes": [
    {
      "fields": [
        "transaction_date"
      ],
      "company_scoped": true
    }
  ],
  "unique": [
    {
      "fields": [
        "journal_number"
      ],
      "company_scoped": true
    }
  ],
  "references": {}
}
